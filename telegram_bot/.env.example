# devnet or mainnet. Hosts, mint, and RPC are chosen in src/constants.ts.
NETWORK=devnet

TELEGRAM_BOT_TOKEN=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Optional. When set, RPC is the Helius host for NETWORK. Otherwise the public cluster RPC.
HELIUS_API_KEY=

# true prints each step, load, and error detail to the console.
DEBUG=false
