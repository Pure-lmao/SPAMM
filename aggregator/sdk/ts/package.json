{
   "name": "spamm-aggregator-sdk",
   "version": "0.0.1",
   "license": "CC-BY-NC-4.0",
   "type": "module",
   "packageManager": "bun@1.2.2",
   "main": "./src/index.ts",
   "types": "./src/index.ts",
   "exports": {
      ".": {
         "types": "./src/index.ts",
         "import": "./src/index.ts",
         "default": "./src/index.ts"
      },
      "./src/*": "./src/*"
   },
   "files": [
      "dist",
      "src"
   ],
   "scripts": {
      "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true }); } catch {}\"",
      "check": "tsc --noEmit",
      "build": "bun run clean && tsc -p tsconfig.build.json",
      "prepack": "bun run build"
   },
   "dependencies": {
      "@solana/kit": "^6.8.0"
   },
   "devDependencies": {
      "typescript": "^5.7.2"
   }
}
