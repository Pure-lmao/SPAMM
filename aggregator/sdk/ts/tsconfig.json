{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "declaration": true,
      "verbatimModuleSyntax": false,
      "isolatedModules": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "rootDir": "src",
      "outDir": "dist"
   },
   "include": ["src/**/*.ts"]
}
